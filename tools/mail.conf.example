# tools/mail.conf.example - copy to tools/mail.conf (never tracked) and fill in.
#
# The account's Maildir root. The Inbox is its cur/ and new/.
MAIL_BASE=/var/mail/example.org/user/
# Extra folders to watch, space-separated, in Maildir ".name" form.
MAIL_FOLDERS=.publisher
# The Sent folder. Only mail addressed TO a correspondent is reported from it.
SENT_FOLDER=.Sent
# A correspondent, matched against From/To/Cc. Case-insensitive.
WHO_REGEX=publisher\.example|surname
# A relevant Subject from anyone. Case-insensitive.
TOPIC_REGEX=in search of dharma

# --- mailsend.py ---
# The From header, and the envelope sender (where a bounce comes back to).
SEND_FROM=BookBot <user@example.org>
SEND_ENVELOPE=user@example.org
# Domain part of generated Message-IDs.
MSGID_DOMAIN=example.org
# Optional: copied on everything sent, so the author sees what went out.
SEND_CC=user@example.org
